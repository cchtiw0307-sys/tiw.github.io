    "r_hypomg_severe": {
      "type": "result",
      "urgency": "red",
      "title": "嚴重低血鎂（Mg < 1.2 或心律不整／抽搐）：MgSO₄ 2 g IV over 10–20 min → 4–8 g/24 hr",
      "summary": "**MgSO₄ 2 g in NS 50–100 mL over 10–20 min（TdP／心跳停止：2 g over 1–2 min IV push）**，之後 **4–8 g in NS 500–1,000 mL over 12–24 hr**（補太快腎臟會排掉一半）；腎衰竭（CrCl < 30）減半；同時補 K、Ca；常需 3–5 天補足。",
      "steps": [
        "心電監測、12 導程 ECG（QT/PR、TdP）；IV",
        "抽：Mg、K、Ca（游離）、P、Cr；FEMg（> 2–4% 腎流失）",
        "TdP／心跳停止 → MgSO₄ 2 g IV push over 1–2 min（Ch5／Ch38）；其他嚴重症狀 → 2 g over 10–20 min",
        "接 4–8 g over 12–24 hr 慢滴（CrCl < 30 減半、密切監測）",
        "同時補 K（Ch33）、Ca（Ch34）：先補鎂或同時，否則補不起來",
        "Mg q6–12h；目標症狀者 > 2；常需 3–5 天",
        "停 PPI／利尿劑（或換保鉀）、cisplatin／aminoglycoside 評估；酒精戒斷處置",
        "快速給會潮紅、低血壓、深腱反射↓ → 減慢"
      ],
      "orders": [
        {
          "drug": "MgSO₄（台灣 10% 20 mL = 2 g；50% 2 mL = 1 g）",
          "dose": "2 g in NS 50–100 mL",
          "route": "IV drip over 10–20 min",
          "freq": "STAT；嚴重症狀／心律不整",
          "note": "TdP／心跳停止：2 g over 1–2 min IV push；1 g = 8 mEq = 4 mmol"
        },
        {
          "drug": "MgSO₄ 維持",
          "dose": "{crcl < 30 ? '2–4 g' : '4–8 g'} in NS 500–1,000 mL",
          "route": "IV drip over 12–24 hr",
          "freq": "持續；依 Mg q6–12h 調，常需 3–5 天",
          "note": "CrCl {round(crcl)}：< 30 減半並密切監測（反射、呼吸）"
        },
        {
          "drug": "KCl",
          "dose": "20–40 mEq",
          "route": "PO（或 IV 依 Ch33）",
          "freq": "q4–6h PRN K < 3.5（補鎂後或同時）",
          "note": "低鎂不補 K 補不起來"
        },
        {
          "drug": "Calcium gluconate 10%",
          "dose": "1–2 g in 50–100 mL",
          "route": "IV drip over 10–20 min",
          "freq": "PRN 症狀性低血鈣",
          "note": "補 Mg 後 Ca 常自行回升（Ch34）"
